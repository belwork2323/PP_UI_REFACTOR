{
  "schemaVersion": "1.0",
  "motorStage": 1,
  "schemaType": "CASTING",
  "functionality": "CREATE_CASTING_FORM",
  "meta": {
    "title": "Casting Form",
    "description": "Casting process details for single motor"
  },
  "data": {
    "ui": {
      "layout": "accordion",
      "gap": "md",
      "sectionVariant": "card"
    },
    "context": {
      "motorStage": 1,
      "subDepartmentId": "{{subDepartmentId}}",
      "motorId": "{{motorId}}"
    },
    "sections": [
      {
        "id": "FINAL_ASSEMBLY_DETAILS",
        "title": "Section A: Final Assembly Details",
        "ui": {
          "variant": "card",
          "padding": "sm",
          "density": "compact",
          "gap": "sm"
        },
        "children": [
          {
            "type": "display",
            "id": "FINAL_ASSEMBLY_STAGE_LABEL",
            "displayType": "description",
            "label": "Fill Assembly Details"
          },
          {
            "type": "section",
            "id": "motorCasing",
            "title": "Rocket Motor Casing {index}",
            "repeat": {
              "defaultCount": 1,
              "min": 1,
              "max": 10,
              "allowAdd": true,
              "allowDelete": true,
              "label": "Rocket Motor Casing {index}"
            },
            "ui": {
              "direction": "column",
              "gap": "sm"
            },
            "children": [
              {
                "type": "table",
                "id": "MANDREL_MEASUREMENTS",
                "label": "Distance between centering top to mandrel top (mm)",
                "rows": {
                  "defaultCount": 3,
                  "allowAdd": true,
                  "allowDelete": true,
                  "autoIncrementKey": "srNo"
                },
                "columns": [
                  {
                    "type": "column",
                    "id": "srNo",
                    "fieldType": "serial",
                    "label": "Sr. No."
                  },
                  {
                    "type": "group",
                    "id": "MANDREL_DOME_A",
                    "label": "Mandrel rest on dome of motor (A)",
                    "columns": [
                      {
                        "type": "column",
                        "id": "A_MOCK",
                        "fieldType": "number",
                        "label": "Mock assy.",
                        "unit": "mm"
                      }
                    ]
                  },
                  {
                    "type": "group",
                    "id": "BOTTOM_CUP_B",
                    "label": "Mandrel rest on bottom cup (with Teflon sleeve) (B)",
                    "columns": [
                      {
                        "type": "column",
                        "id": "B_MOCK",
                        "fieldType": "number",
                        "label": "Mock assy.",
                        "unit": "mm"
                      },
                      {
                        "type": "column",
                        "id": "B_FINAL",
                        "fieldType": "number",
                        "label": "Final assy.",
                        "unit": "mm"
                      }
                    ]
                  },
                  {
                    "type": "group",
                    "id": "DIFFERENCE_C",
                    "label": "Difference C=(A-B)",
                    "columns": [
                      {
                        "type": "column",
                        "id": "C_MOCK",
                        "fieldType": "formula",
                        "label": "Mock assy.",
                        "formula": {
                          "expression": "A_MOCK-B_MOCK",
                          "dependencies": ["A_MOCK", "B_MOCK"]
                        },
                        "readonly": true
                      },
                      {
                        "type": "column",
                        "id": "C_FINAL",
                        "fieldType": "formula",
                        "label": "Final assy.",
                        "formula": {
                          "expression": "A_MOCK-B_FINAL",
                          "dependencies": ["A_MOCK", "B_FINAL"]
                        },
                        "readonly": true
                      }
                    ]
                  },
                  {
                    "type": "column",
                    "id": "BELLOWS_THICKNESS_D",
                    "fieldType": "number",
                    "label": "Bellow thickness (D)",
                    "unit": "mm"
                  },
                  {
                    "type": "group",
                    "id": "MANDREL_LIFT_E",
                    "label": "Mandrel lift E=(C-D)",
                    "columns": [
                      {
                        "type": "column",
                        "id": "E_MOCK",
                        "fieldType": "formula",
                        "label": "Mock assy.",
                        "formula": {
                          "expression": "C_MOCK-BELLOWS_THICKNESS_D",
                          "dependencies": ["C_MOCK", "BELLOWS_THICKNESS_D"]
                        },
                        "readonly": true
                      },
                      {
                        "type": "column",
                        "id": "E_FINAL",
                        "fieldType": "formula",
                        "label": "Final assy.",
                        "formula": {
                          "expression": "C_FINAL-BELLOWS_THICKNESS_D",
                          "dependencies": ["C_FINAL", "BELLOWS_THICKNESS_D"]
                        },
                        "readonly": true
                      }
                    ]
                  }
                ]
              },
              {
                "type": "table",
                "id": "FEED_PIPE_DISTANCE",
                "label": "Measurement of distance between feed pipe & cone apex",
                "rows": {
                  "defaultCount": 1,
                  "allowAdd": false,
                  "allowDelete": false
                },
                "columns": [
                  {
                    "type": "column",
                    "id": "READING_1",
                    "fieldType": "number",
                    "label": "Reading 1",
                    "unit": "mm"
                  },
                  {
                    "type": "column",
                    "id": "READING_2",
                    "fieldType": "number",
                    "label": "Reading 2",
                    "unit": "mm"
                  }
                ]
              },
              {
                "type": "field",
                "id": "EMPTY_MOTOR_WEIGHT",
                "fieldType": "number",
                "label": "Weight of assembled empty motor casing",
                "unit": "kg",
                "ui": {
                  "sx": { "mb": 0 }
                }
              }
            ]
          }
        ]
      },
      {
        "id": "CASTING_PROCESS",
        "title": "Section B: Casting Process",
        "children": [
          {
            "type": "table",
            "id": "FINAL_MIX_BOWL_DETAILS",
            "label": "Final Mix Bowl Details",
            "rows": {
              "allowAdd": false,
              "allowDelete": false,
              "autoIncrementKey": "SR_NO",
              "populateFromApi": {
                "dataSource": {
                  "type": "api",
                  "api": {
                    "endpoint": "/api/v1/admin/batch/details",
                    "method": "POST",
                    "requestBody": {
                      "batchId": "{{batchId}}"
                    },
                    "responsePath": "data.batch.identificationSheet.metadata.mixing.stages",
                    "nestedOptionsKey": "premixes",
                    "parentMatchField": "stageType",
                    "parentMatchContextKey": "mixingStageType"
                  }
                },
                "columnTemplates": [
                  {
                    "targetColumn": "BOWL_ID",
                    "template": "FINAL_MIX {premixNo} / {bowlId}"
                  }
                ],
                "fieldMappings": [
                  {
                    "sourceField": "premixNo",
                    "targetColumn": "PREMIX_NO"
                  },
                  {
                    "sourceField": "bowlId",
                    "targetColumn": "BOWL_NO"
                  }
                ],
                "readonlyColumns": ["BOWL_ID", "PREMIX_NO", "BOWL_NO"]
              }
            },
            "columns": [
              {
                "type": "column",
                "id": "BOWL_ID",
                "fieldType": "static",
                "label": "Bowl Id",
                "readonly": true
              },
              {
                "type": "column",
                "id": "BOWL_RECEIPT_TIME",
                "fieldType": "time",
                "label": "Bowl Receipt Time"
              },
              {
                "type": "column",
                "id": "INITIAL_WEIGHT",
                "fieldType": "number",
                "label": "Initial Weight"
              },
              {
                "type": "column",
                "id": "FINAL_WEIGHT",
                "fieldType": "number",
                "label": "Final Weight"
              },
              {
                "type": "column",
                "id": "INITIAL_SLURRY_DEPTH",
                "fieldType": "number",
                "label": "Initial Slurry Depth"
              },
              {
                "type": "column",
                "id": "DC_OPEN_TIME",
                "fieldType": "time",
                "label": "Bowl D/C Valve Opening Time"
              },
              {
                "type": "column",
                "id": "DC_CLOSE_TIME",
                "fieldType": "time",
                "label": "Bowl D/C Valve Closing Time"
              },
              {
                "type": "column",
                "id": "SLURRY_DEPTH_AFTER_DC",
                "fieldType": "number",
                "label": "Depth of Slurry after Opening of D/C Valve"
              },
              {
                "type": "column",
                "id": "BALL_VALVE_OPEN_TIME",
                "fieldType": "time",
                "label": "Ball Valve Opening Time"
              }
            ]
          },
          {
            "type": "table",
            "id": "CASTING_FROM_BOWL_DETAILS",
            "label": "Casting From Bowl Details",
            "rows": {
              "allowAdd": false,
              "allowDelete": false,
              "autoIncrementKey": "SR_NO",
              "populateFromApi": {
                "dataSource": {
                  "type": "api",
                  "api": {
                    "endpoint": "/api/v1/admin/batch/details",
                    "method": "POST",
                    "requestBody": {
                      "batchId": "{{batchId}}"
                    },
                    "responsePath": "data.batch.identificationSheet.metadata.mixing.stages",
                    "nestedOptionsKey": "premixes",
                    "parentMatchField": "stageType",
                    "parentMatchContextKey": "mixingStageType"
                  }
                },
                "columnTemplates": [
                  {
                    "targetColumn": "BOWL_ID",
                    "template": "FINAL_MIX {premixNo} / {bowlId}"
                  }
                ],
                "fieldMappings": [
                  {
                    "sourceField": "premixNo",
                    "targetColumn": "PREMIX_NO"
                  },
                  {
                    "sourceField": "bowlId",
                    "targetColumn": "BOWL_NO"
                  }
                ],
                "contextColumnMappings": {
                  "MOTOR_ID": "motorId"
                },
                "readonlyColumns": ["BOWL_ID", "PREMIX_NO", "BOWL_NO", "MOTOR_ID"]
              }
            },
            "columns": [
              {
                "type": "column",
                "id": "BOWL_ID",
                "fieldType": "static",
                "label": "Bowl Id",
                "readonly": true
              },
              {
                "type": "column",
                "id": "TIME_INTERVAL",
                "fieldType": "number",
                "label": "Time Interval",
                "unit": "hrs"
              },
              {
                "type": "column",
                "id": "RH",
                "fieldType": "number",
                "label": "RH",
                "unit": "%"
              },
              {
                "type": "column",
                "id": "VISCOSITY",
                "fieldType": "number",
                "label": "Viscosity",
                "unit": "Poise"
              },
              {
                "type": "column",
                "id": "MOTOR_ID",
                "fieldType": "text",
                "label": "Motor Id No.",
                "readonly": true
              },
              {
                "type": "column",
                "id": "SLURRY_DEPTH",
                "fieldType": "number",
                "label": "Slurry Depth",
                "unit": "cm"
              },
              {
                "type": "column",
                "id": "SLURRY_CAST",
                "fieldType": "number",
                "label": "Slurry Cast",
                "unit": "kg"
              },
              {
                "type": "column",
                "id": "FLOW_RATE",
                "fieldType": "number",
                "label": "Flow Rate",
                "unit": "kg/min"
              },
              {
                "type": "column",
                "id": "VALVE_OPENING",
                "fieldType": "number",
                "label": "Valve Opening",
                "unit": "%"
              },
              {
                "type": "column",
                "id": "VACUUM_LEVEL",
                "fieldType": "number",
                "label": "Vacuum Level",
                "unit": "torr"
              }
            ]
          },
          {
            "type": "group",
            "id": "CASTING_VACUUM_DETAILS",
            "ui": {
              "direction": "row",
              "wrap": true,
              "gap": "md"
            },
            "children": [
              {
                "type": "field",
                "id": "INITIAL_VACUUM",
                "fieldType": "number",
                "label": "Initial Vacuum",
                "ui": {
                  "placeholder": "Enter value"
                }
              },
              {
                "type": "field",
                "id": "VACUUM_PRESSURE_CASTING",
                "fieldType": "number",
                "label": "Vacuum Pressure Created for Casting",
                "ui": {
                  "placeholder": "Enter value"
                }
              },
              {
                "type": "field",
                "id": "VACUUM_PRESSURE_SOAKING",
                "fieldType": "number",
                "label": "Vacuum Pressure Created for Soaking",
                "ui": {
                  "placeholder": "Enter value"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "SLURRY_CAST_DETAILS",
        "title": "Section C: Slurry Cast into motor from bowls",
        "ui": {
          "variant": "card",
          "padding": "sm",
          "gap": "sm"
        },
        "children": [
          {
            "type": "table",
            "id": "SLURRY_CAST_FROM_BOWLS",
            "rows": {
              "allowAdd": false,
              "allowDelete": false,
              "autoIncrementKey": "ROW_KEY",
              "populateFromApi": {
                "dataSource": {
                  "type": "api",
                  "api": {
                    "endpoint": "/api/v1/admin/batch/details",
                    "method": "POST",
                    "requestBody": {
                      "batchId": "{{batchId}}"
                    },
                    "responsePath": "data.batch.identificationSheet.metadata.mixing.stages",
                    "nestedOptionsKey": "premixes",
                    "parentMatchField": "stageType",
                    "parentMatchContextKey": "mixingStageType"
                  }
                },
                "columnTemplates": [
                  {
                    "targetColumn": "FM_MOTOR_LABEL",
                    "template": "FINAL_MIX {premixNo} / {bowlId}"
                  }
                ],
                "fieldMappings": [
                  {
                    "sourceField": "premixNo",
                    "targetColumn": "PREMIX_NO"
                  },
                  {
                    "sourceField": "bowlId",
                    "targetColumn": "BOWL_NO"
                  }
                ],
                "readonlyColumns": ["FM_MOTOR_LABEL", "PREMIX_NO", "BOWL_NO"]
              },
              "rowComputations": [
                {
                  "rowKey": "TOTAL",
                  "rowKeyColumn": "ROW_KEY",
                  "targetColumn": "SLURRY_CAST",
                  "sourceColumn": "SLURRY_CAST",
                  "expression": "__SUM__"
                }
              ],
              "presetRows": [
                {
                  "readonly": true,
                  "ROW_KEY": "TOTAL",
                  "FM_MOTOR_LABEL": "Total Slurry Cast",
                  "SLURRY_CAST__fieldType": "number"
                }
              ]
            },
            "columns": [
              {
                "type": "column",
                "id": "FM_MOTOR_LABEL",
                "fieldType": "static",
                "label": "FM/Motor Id",
                "readonly": true
              },
              {
                "type": "column",
                "id": "SLURRY_CAST",
                "fieldType": "number",
                "label": "Slurry Cast",
                "unit": "kg"
              }
            ]
          }
        ]
      },
      {
        "id": "POST_CAST_OPERATIONS",
        "title": "Section D: Post Cast Operations",
        "children": [
          {
            "type": "table",
            "id": "POST_CAST_TABLE",
            "rows": {
              "defaultCount": 6,
              "allowAdd": false,
              "allowDelete": false,
              "presetRows": [
                {
                  "readonly": true,
                  "ACTIVITY": "Soaking Time",
                  "DETAILS__fieldType": "time"
                },
                {
                  "readonly": true,
                  "ACTIVITY": "Time of removal from pit",
                  "DETAILS__fieldType": "time"
                },
                {
                  "readonly": true,
                  "ACTIVITY": "Fixtures assembled for curing",
                  "DETAILS__fieldType": "text"
                },
                {
                  "readonly": true,
                  "ACTIVITY": "Pressure sensor details (If applicable)",
                  "DETAILS__fieldType": "text"
                },
                {
                  "readonly": true,
                  "ACTIVITY": "Initial pressure reading (If applicable)",
                  "DETAILS__fieldType": "text"
                },
                {
                  "readonly": true,
                  "ACTIVITY": "Time of dispatch to curing station",
                  "DETAILS__fieldType": "time"
                }
              ]
            },
            "columns": [
              {
                "type": "column",
                "id": "ACTIVITY",
                "fieldType": "static",
                "label": "Activity",
                "readonly": true
              },
              {
                "type": "column",
                "id": "DETAILS",
                "fieldType": "dynamic",
                "label": "Post Cast Operation Details"
              }
            ]
          }
        ]
      }
 
    ]
  }
}
