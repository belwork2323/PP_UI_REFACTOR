{
  "schemaVersion": "1.0",
  "schemaType": "POST_CURE",
  "functionality": "CREATE_POST_CURE_FORM",
  "operationType": "INHIBITION",
  "inhibitorType": "IR1",
  "meta": {
    "title": "IR1 Preparation Details",
    "description": "IR1 premix preparation, final mix preparation and qualification details"
  },
  "data": {
    "ui": {
      "layout": "accordion",
      "gap": "md",
      "sectionVariant": "card",
      "accordion": {
        "defaultExpanded": true,
        "allowMultipleExpanded": true
      }
    },
    "context": {
      "subDepartmentId": "{{subDepartmentId}}",
      "batchId": "{{batchId}}"
    },
    "sections": [
      {
        "id": "IR1_PREMIX",
        "title": "IR-1 Premix",
        "ui": { "variant": "card", "padding": "md" },
        "children": [
          {
            "type": "group",
            "id": "IR1_PREMIX_BATCH_FIELDS",
            "ui": {
              "direction": "row",
              "wrap": true,
              "gap": "md",
              "alignItems": "flex-end"
            },
            "children": [
              {
                "type": "field",
                "id": "IR1_PREMIX_BATCH_NO",
                "fieldType": "text",
                "label": "Batch No",
                "ui": {
                  "colSpan": { "xs": 12, "sm": 6, "md": 4 },
                  "maxWidth": "280px"
                }
              },
              {
                "type": "field",
                "id": "IR1_PREMIX_DATE",
                "fieldType": "date",
                "label": "Premix Date",
                "ui": {
                  "colSpan": { "xs": 12, "sm": 6, "md": 4 },
                  "maxWidth": "280px"
                }
              }
            ]
          },
          {
            "type": "table",
            "id": "IR1_PREMIX_TABLE",
            "rows": {
              "defaultCount": 4,
              "allowAdd": false,
              "allowDelete": false,
              "autoIncrementKey": "srNo",
              "rowComputations": [
                {
                  "rowKey": "TOTAL",
                  "rowKeyColumn": "srNo",
                  "targetColumn": "QTY_TAKEN",
                  "sourceColumn": "QTY_TAKEN",
                  "expression": "__SUM__",
                  "editable": true
                }
              ],
              "presetRows": [
                { "readonly": true, "INGREDIENT": "Castor Oil", "PARTS_BY_WEIGHT": "60.0±1.0" },
                { "readonly": true, "INGREDIENT": "Asbestos Powder", "PARTS_BY_WEIGHT": "38.5±1.0" },
                { "readonly": true, "INGREDIENT": "Nonox-D", "PARTS_BY_WEIGHT": "1.0±0.1" },
                { "readonly": true, "INGREDIENT": "Ferric Oxide", "PARTS_BY_WEIGHT": "0.5±0.05" },
                {
                  "readonly": true,
                  "srNo": "TOTAL",
                  "INGREDIENT": "Total Quantity",
                  "MFG_LOT": "",
                  "PARTS_BY_WEIGHT": "",
                  "MFG_LOT__fieldType": "static",
                  "PARTS_BY_WEIGHT__fieldType": "static",
                  "QTY_TAKEN__fieldType": "number"
                }
              ]
            },
            "columns": [
              {
                "type": "column",
                "id": "srNo",
                "fieldType": "serial",
                "label": "Sr No.",
                "readonly": true
              },
              {
                "type": "column",
                "id": "INGREDIENT",
                "fieldType": "static",
                "label": "Ingredient",
                "readonly": true
              },
              {
                "type": "column",
                "id": "MFG_LOT",
                "fieldType": "text",
                "label": "Mfg. Lot"
              },
              {
                "type": "column",
                "id": "PARTS_BY_WEIGHT",
                "fieldType": "static",
                "label": "Parts by Wt.",
                "readonly": true
              },
              {
                "type": "column",
                "id": "QTY_TAKEN",
                "fieldType": "number",
                "label": "Qty taken (g)"
              }
            ]
          }
        ]
      },
      {
        "id": "IR1_FINAL_MIX",
        "title": "Final Mix",
        "ui": { "variant": "card", "padding": "md" },
        "children": [
          {
            "type": "group",
            "id": "IR1_FINAL_MIX_BATCH_FIELDS",
            "ui": {
              "direction": "row",
              "wrap": true,
              "gap": "md",
              "alignItems": "flex-end"
            },
            "children": [
              {
                "type": "field",
                "id": "IR1_FINAL_MIX_BATCH_NO",
                "fieldType": "text",
                "label": "Batch No",
                "ui": {
                  "colSpan": { "xs": 12, "sm": 6, "md": 4 },
                  "maxWidth": "280px"
                }
              },
              {
                "type": "field",
                "id": "IR1_FINAL_MIX_DATE",
                "fieldType": "date",
                "label": "Final Mix Date",
                "ui": {
                  "colSpan": { "xs": 12, "sm": 6, "md": 4 },
                  "maxWidth": "280px"
                }
              }
            ]
          },
          {
            "type": "table",
            "id": "IR1_FINAL_MIX_TABLE",
            "rows": {
              "defaultCount": 3,
              "allowAdd": false,
              "allowDelete": false,
              "autoIncrementKey": "srNo",
              "rowComputations": [
                {
                  "rowKey": "TOTAL",
                  "rowKeyColumn": "srNo",
                  "targetColumn": "QTY_TAKEN",
                  "sourceColumn": "QTY_TAKEN",
                  "expression": "__SUM__",
                  "editable": true
                }
              ],
              "presetRows": [
                { "readonly": true, "INGREDIENT": "IR-1 Premix", "PARTS_BY_WEIGHT": "100" },
                { "readonly": true, "INGREDIENT": "TDI", "PARTS_BY_WEIGHT": "14.5" },
                {
                  "readonly": true,
                  "INGREDIENT": "Catalyst (5% w/w FeAA in benzene)",
                  "PARTS_BY_WEIGHT": "2 ml"
                },
                {
                  "readonly": true,
                  "srNo": "TOTAL",
                  "INGREDIENT": "Total Quantity",
                  "MFG_LOT": "",
                  "PARTS_BY_WEIGHT": "",
                  "MFG_LOT__fieldType": "static",
                  "PARTS_BY_WEIGHT__fieldType": "static",
                  "QTY_TAKEN__fieldType": "number"
                }
              ]
            },
            "columns": [
              {
                "type": "column",
                "id": "srNo",
                "fieldType": "serial",
                "label": "Sr No.",
                "readonly": true
              },
              {
                "type": "column",
                "id": "INGREDIENT",
                "fieldType": "static",
                "label": "Ingredient",
                "readonly": true
              },
              {
                "type": "column",
                "id": "MFG_LOT",
                "fieldType": "text",
                "label": "Mfg. Lot"
              },
              {
                "type": "column",
                "id": "PARTS_BY_WEIGHT",
                "fieldType": "static",
                "label": "Parts by Wt.",
                "readonly": true
              },
              {
                "type": "column",
                "id": "QTY_TAKEN",
                "fieldType": "number",
                "label": "Qty taken (g)"
              }
            ]
          }
        ]
      },
      {
        "id": "IR1_QUALIFICATION",
        "title": "Qualification Details",
        "ui": { "variant": "card", "padding": "md" },
        "children": [
          {
            "type": "group",
            "id": "QUALIFICATION_BATCH_FIELDS",
            "ui": {
              "direction": "row",
              "wrap": true,
              "gap": "md",
              "alignItems": "flex-end"
            },
            "children": [
              {
                "type": "field",
                "id": "QUALIFICATION_BATCH_NO",
                "fieldType": "text",
                "label": "Batch No",
                "ui": {
                  "colSpan": { "xs": 12, "sm": 6, "md": 4 },
                  "maxWidth": "280px"
                }
              },
              {
                "type": "field",
                "id": "QUALIFICATION_PREPARATION_DATE",
                "fieldType": "date",
                "label": "Date of Preparation",
                "ui": {
                  "colSpan": { "xs": 12, "sm": 6, "md": 4 },
                  "maxWidth": "280px"
                }
              }
            ]
          },
          {
            "type": "table",
            "id": "QUALIFICATION_TABLE",
            "rows": {
              "defaultCount": 2,
              "allowAdd": false,
              "allowDelete": false,
              "autoIncrementKey": "srNo",
              "presetRows": [
                { "readonly": true, "PARAMETER": "Tensile Strength", "SPECIFICATION": ">=8 KSC" },
                { "readonly": true, "PARAMETER": "% Elongation", "SPECIFICATION": ">=30" }
              ]
            },
            "columns": [
              {
                "type": "column",
                "id": "srNo",
                "fieldType": "serial",
                "label": "Sr No.",
                "readonly": true
              },
              {
                "type": "column",
                "id": "PARAMETER",
                "fieldType": "static",
                "label": "Parameter",
                "readonly": true
              },
              {
                "type": "column",
                "id": "SPECIFICATION",
                "fieldType": "static",
                "label": "Specification",
                "readonly": true
              },
              {
                "type": "column",
                "id": "RESULT",
                "fieldType": "text",
                "label": "Result"
              }
            ]
          },
          {
            "type": "field",
            "id": "QUALIFICATION_QC_REPORT",
            "fieldType": "file",
            "label": "QC Report"
          }
        ]
      },
      {
        "id": "INHIBITION_BATCH_DETAILS",
        "title": "Inhibitor Batch Information",
        "ui": {
          "variant": "card",
          "padding": "md",
          "direction": "row",
          "wrap": true,
          "gap": "md"
        },
        "children": [
          {
            "type": "field",
            "id": "INHIBITOR_BATCH_NO",
            "fieldType": "text",
            "label": "Batch No"
          },
          {
            "type": "field",
            "id": "INHIBITOR_BATCH_SIZE",
            "fieldType": "number",
            "label": "Batch Size",
            "unit": "g"
          }
        ]
      },
      {
        "id": "INHIBITION_APPLICATION_DETAILS",
        "title": "Inhibition Application Details",
        "ui": { "variant": "card", "padding": "md" },
        "children": [
          {
            "type": "table",
            "id": "INHIBITION_APPLICATION_TABLE",
            "rows": {
              "defaultCount": 2,
              "allowAdd": false,
              "allowDelete": false,
              "presetRows": [
                { "readonly": true, "LOCATION": "HE_SIDE" },
                { "readonly": true, "LOCATION": "NE_SIDE" }
              ]
            },
            "columns": [
              {
                "type": "column",
                "id": "LOCATION",
                "fieldType": "static",
                "label": "Location",
                "readonly": true
              },
              {
                "type": "column",
                "id": "FROM_DATE",
                "fieldType": "date",
                "label": "From Date"
              },
              {
                "type": "column",
                "id": "TO_DATE",
                "fieldType": "date",
                "label": "To Date"
              },
              {
                "type": "column",
                "id": "QTY_APPLIED",
                "fieldType": "number",
                "label": "Qty Applied (g)"
              },
              {
                "type": "column",
                "id": "OBSERVATIONS",
                "fieldType": "textarea",
                "label": "Observations"
              }
            ]
          }
        ]
      },
      {
        "id": "DISPATCH_DETAILS",
        "title": "Dispatch Details",
        "ui": {
          "variant": "card",
          "padding": "md",
          "direction": "row",
          "wrap": true,
          "gap": "md"
        },
        "children": [
          {
            "type": "field",
            "id": "DISPATCH_DATE",
            "fieldType": "date",
            "label": "Date Of Dispatch"
          },
          {
            "type": "field",
            "id": "DISPATCH_STATION",
            "fieldType": "dropdown",
            "label": "Dispatch Station",
            "dataSource": {
              "type": "api",
              "api": {
                "endpoint": "CASTING_STATION_LIST",
                "method": "GET",
                "requestBody": {
                  "subDepartmentId": "{{subDepartmentId}}"
                },
                "responsePath": "data.materials",
                "displayKey": "stationName",
                "valueKey": "stationCode"
              }
            }
          }
        ]
      }
    ]
  }
}
