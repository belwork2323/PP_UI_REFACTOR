{
  "schemaVersion": "1.0",
  "schemaType": "POST_CURE",
  "functionality": "CREATE_POST_CURE_FORM",
  "operationType": "LOOSE_FLAP_FILLING",
  "meta": {
    "title": "Loose Flap Filling",
    "description": "Bellow removal, epoxy preparation, qualification and loose flap epoxy filling details"
  },
  "data": {
    "ui": {
      "layout": "accordion",
      "gap": "md",
      "sectionVariant": "card",
      "accordion": {
        "defaultExpanded": true,
        "allowMultipleExpanded": true
      }
    },
    "context": {
      "subDepartmentId": "{{subDepartmentId}}",
      "batchId": "{{batchId}}"
    },
    "sections": [
      {
        "id": "BELLOW_REMOVAL_DETAILS",
        "title": "Bellow Removal Details",
        "ui": { "variant": "card", "padding": "md" },
        "children": [
          {
            "type": "table",
            "id": "BELLOW_REMOVAL_TABLE",
            "rows": {
              "defaultCount": 2,
              "allowAdd": false,
              "allowDelete": false,
              "presetRows": [
                { "readonly": true, "LOCATION": "HE_SIDE" },
                { "readonly": true, "LOCATION": "NE_SIDE" }
              ]
            },
            "columns": [
              {
                "type": "column",
                "id": "LOCATION",
                "fieldType": "static",
                "label": "Location",
                "readonly": true
              },
              {
                "type": "column",
                "id": "FROM_DATE",
                "fieldType": "date",
                "label": "From Date"
              },
              {
                "type": "column",
                "id": "TO_DATE",
                "fieldType": "date",
                "label": "To Date"
              },
              {
                "type": "column",
                "id": "OBSERVATIONS",
                "fieldType": "textarea",
                "label": "Observations"
              }
            ]
          }
        ]
      },
      {
        "id": "LOOSE_FLAP_EPOXY_PREPARATION",
        "title": "Loose Flap Epoxy Preparation Details",
        "ui": { "variant": "card", "padding": "md" },
        "children": [
          {
            "type": "table",
            "id": "PREPARATION_DETAILS",
            "rows": {
              "defaultCount": 4,
              "allowAdd": true,
              "allowDelete": true,
              "min": 4,
              "autoIncrementKey": "srNo",
              "addLabel": "Add Row",
              "rowComputations": [
                {
                  "rowKey": "TOTAL",
                  "rowKeyColumn": "srNo",
                  "targetColumn": "QUANTITY",
                  "sourceColumn": "QUANTITY",
                  "expression": "__SUM__",
                  "editable": true
                }
              ],
              "presetRows": [
                {
                  "readonly": true,
                  "INGREDIENT": "A-125 Hardener",
                  "PARTS_BY_WEIGHT": "60 ±1",
                  "INGREDIENT__fieldType": "static",
                  "PARTS_BY_WEIGHT__fieldType": "static"
                },
                {
                  "readonly": true,
                  "INGREDIENT": "GX-257 Resin",
                  "PARTS_BY_WEIGHT": "40 ±1",
                  "INGREDIENT__fieldType": "static",
                  "PARTS_BY_WEIGHT__fieldType": "static"
                },
                {
                  "readonly": true,
                  "INGREDIENT": "HY-960 Accelerator",
                  "PARTS_BY_WEIGHT": "6 ±0.5",
                  "INGREDIENT__fieldType": "static",
                  "PARTS_BY_WEIGHT__fieldType": "static"
                },
                {
                  "readonly": true,
                  "INGREDIENT": "DY-026 Diluent",
                  "PARTS_BY_WEIGHT": "10 ±0.5",
                  "INGREDIENT__fieldType": "static",
                  "PARTS_BY_WEIGHT__fieldType": "static"
                },
                {
                  "readonly": true,
                  "srNo": "TOTAL",
                  "INGREDIENT": "Total Quantity",
                  "MFG_LOT": "",
                  "PARTS_BY_WEIGHT": "",
                  "INGREDIENT__fieldType": "static",
                  "MFG_LOT__fieldType": "static",
                  "PARTS_BY_WEIGHT__fieldType": "static",
                  "QUANTITY__fieldType": "number"
                }
              ]
            },
            "columns": [
              {
                "type": "column",
                "id": "INGREDIENT",
                "fieldType": "text",
                "label": "Ingredient"
              },
              {
                "type": "column",
                "id": "MFG_LOT",
                "fieldType": "text",
                "label": "Mfg Lot"
              },
              {
                "type": "column",
                "id": "PARTS_BY_WEIGHT",
                "fieldType": "text",
                "label": "Parts By Weight"
              },
              {
                "type": "column",
                "id": "QUANTITY",
                "fieldType": "number",
                "label": "Quantity (g)"
              }
            ]
          }
        ]
      },
      {
        "id": "QUALIFICATION_DETAILS",
        "title": "Qualification Details",
        "ui": { "variant": "card", "padding": "md" },
        "children": [
          {
            "type": "group",
            "id": "QUALIFICATION_BATCH_FIELDS",
            "ui": {
              "direction": "row",
              "wrap": true,
              "gap": "md",
              "alignItems": "flex-end"
            },
            "children": [
              {
                "type": "field",
                "id": "QUALIFICATION_BATCH_NO",
                "fieldType": "text",
                "label": "Batch No",
                "ui": {
                  "colSpan": { "xs": 12, "sm": 6, "md": 4 },
                  "maxWidth": "280px"
                }
              },
              {
                "type": "field",
                "id": "QUALIFICATION_PREPARATION_DATE",
                "fieldType": "date",
                "label": "Date of Preparation",
                "ui": {
                  "colSpan": { "xs": 12, "sm": 6, "md": 4 },
                  "maxWidth": "280px"
                }
              }
            ]
          },
          {
            "type": "table",
            "id": "QUALIFICATION_TABLE",
            "rows": {
              "defaultCount": 2,
              "allowAdd": false,
              "allowDelete": false,
              "presetRows": [
                { "readonly": true, "PARAMETER": "Tensile Strength", "SPECIFICATION": ">=40 KSC" },
                { "readonly": true, "PARAMETER": "% Elongation", "SPECIFICATION": ">=25" }
              ]
            },
            "columns": [
              {
                "type": "column",
                "id": "PARAMETER",
                "fieldType": "static",
                "label": "Parameter",
                "readonly": true
              },
              {
                "type": "column",
                "id": "SPECIFICATION",
                "fieldType": "static",
                "label": "Specification",
                "readonly": true
              },
              {
                "type": "column",
                "id": "RESULT",
                "fieldType": "text",
                "label": "Result"
              }
            ]
          },
          {
            "type": "field",
            "id": "QUALIFICATION_QC_REPORT",
            "fieldType": "file",
            "label": "QC Report"
          }
        ]
      },
      {
        "id": "LF_EPOXY_FILLING_DETAILS",
        "title": "LF Epoxy Filling Details",
        "ui": { "variant": "card", "padding": "md" },
        "children": [
          {
            "type": "table",
            "id": "LF_FILLING_TABLE",
            "rows": {
              "defaultCount": 2,
              "allowAdd": false,
              "allowDelete": false,
              "presetRows": [
                { "readonly": true, "LOCATION": "HE_SIDE" },
                { "readonly": true, "LOCATION": "NE_SIDE" }
              ]
            },
            "columns": [
              {
                "type": "column",
                "id": "LOCATION",
                "fieldType": "static",
                "label": "Location",
                "readonly": true
              },
              {
                "type": "column",
                "id": "FROM_DATE",
                "fieldType": "date",
                "label": "From Date"
              },
              {
                "type": "column",
                "id": "TO_DATE",
                "fieldType": "date",
                "label": "To Date"
              },
              {
                "type": "column",
                "id": "QTY_FILLED",
                "fieldType": "number",
                "label": "Quantity Filled"
              },
              {
                "type": "column",
                "id": "OBSERVATIONS",
                "fieldType": "textarea",
                "label": "Observations"
              }
            ]
          }
        ]
      }
    ]
  }
}
