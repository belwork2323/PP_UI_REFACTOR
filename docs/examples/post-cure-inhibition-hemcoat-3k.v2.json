              "allowAdd": false,
              "allowDelete": false,
              "autoIncrementKey": "srNo",
              "rowComputations": [
                {
                  "rowKey": "TOTAL",
                  "rowKeyColumn": "srNo",
                  "targetColumn": "QTY_TAKEN",
                  "sourceColumn": "QTY_TAKEN",
                  "expression": "__SUM__",
                  "editable": true
                }
