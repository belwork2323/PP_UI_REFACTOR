      "layout": "accordion",
      "gap": "md",
      "sectionVariant": "card",
      "accordion": {
        "defaultExpanded": true,
        "allowMultipleExpanded": true
      }
    },
    "context": {
      "subDepartmentId": "{{subDepartmentId}}",
      "batchId": "{{batchId}}"
    },
    "sections": [
      {
