        "children": [
          {
            "type": "group",
            "id": "HEMCOAT_PREMIX_BATCH_FIELDS",
            "ui": {
              "direction": "row",
              "wrap": true,
              "gap": "md",
              "alignItems": "flex-end"
            },
            "children": [
              {
                "type": "field",
                "id": "HEMCOAT_PREMIX_BATCH_NO",
                "fieldType": "text",
                "label": "Batch No",
                "ui": {
                  "colSpan": { "xs": 12, "sm": 6, "md": 4 },
                  "maxWidth": "280px"
                }
              },
              {
                "type": "field",
                "id": "HEMCOAT_PREMIX_DATE",
                "fieldType": "date",
                "label": "Premix Date",
