              ]
            },
            "columns": [
              {
                "type": "column",
                "id": "srNo",
                "fieldType": "serial",
                "label": "Sr. No",
                "readonly": true
              },
              {
                "type": "column",
                "id": "INGREDIENT",
                "fieldType": "static",
                "label": "Ingredient",
                "readonly": true
              },
              {
                "type": "column",
                "id": "MFG_LOT",
                "fieldType": "text",
                "label": "Mfg Lot"
              },
              {
                "type": "column",
                "id": "PARTS_BY_WEIGHT",
                "fieldType": "static",
                "label": "Parts By Weight",
