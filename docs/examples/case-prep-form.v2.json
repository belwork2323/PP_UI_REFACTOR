{
  "schemaVersion": "1.0",
  "schemaType": "CASE_PREPARATION",
  "functionality": "CREATE_CASE_PREPARATION_FORM",
  "batchType": "MAIN_BATCH",
  "data": {
    "meta": {
      "title": "Case Preparation",
      "description": "Case preparation activities for a single motor before casting operation"
    },
    "ui": {
      "layout": "flat",
      "gap": "md",
      "sectionVariant": "card"
    },
    "context": {
      "batchType": "MAIN_BATCH",
      "batchId": "{{batchId}}",
      "motorId": "{{motorId}}",
      "subDepartmentId": "{{subDepartmentId}}"
    },
    "sections": [
      {
        "id": "abradingOperation",
        "title": "Abrading Operation",
        "children": [
          {
            "type": "display",
            "id": "abradingConfigurationHeading",
            "displayType": "heading",
            "label": "Abrading Configuration",
            "value": "Abrading Configuration"
          },
          {
            "type": "field",
            "id": "typeOfCasing",
            "fieldType": "text",
            "label": "Type of Casting",
            "readonly": true,
            "populateFromApi": {
              "dataSource": {
                "type": "api",
                "api": {
                  "endpoint": "/api/v1/admin/batch/details",
                  "method": "POST",
                  "requestBody": {
                    "batchId": "{{batchId}}"
                  },
                  "responsePath": "data.batch.identificationSheet.metadata.rocketMotorCasing.motors"
                }
              },
              "sourceField": "castingType"
            }
          },
          {
            "type": "field",
            "id": "typeOfInsulation",
            "fieldType": "text",
            "label": "Type of Insulation",
            "readonly": true,
            "populateFromApi": {
              "dataSource": {
                "type": "api",
                "api": {
                  "endpoint": "/api/v1/admin/batch/details",
                  "method": "POST",
                  "requestBody": {
                    "batchId": "{{batchId}}"
                  },
                  "responsePath": "data.batch.identificationSheet.metadata.rocketMotorCasing.motors"
                }
              },
              "sourceField": "insulationType"
            }
          },
          {
            "type": "field",
            "id": "abradingWheelType",
            "fieldType": "dropdown",
            "label": "Abrading Wheel Type",
            "dataSource": {
              "type": "static",
              "options": [
                {
                  "label": "G60",
                  "value": "G60"
                },
                {
                  "label": "G36",
                  "value": "G36"
                }
              ]
            }
          },
          {
            "type": "table",
            "id": "abradingDetails",
            "title": "Abrading Details",
            "rows": {
              "allowAdd": false,
              "allowDelete": false,
              "autoIncrementKey": "SR_NO",
              "defaultCount": 9,
              "presetRows": [
                {
                  "type": "header",
                  "label": "1st Cut"
                },
                {
                  "readonly": true,
                  "operation": "Start Date & Time",
                  "value__fieldType": "datetime"
                },
                {
                  "readonly": true,
                  "operation": "End Date & Time",
                  "value__fieldType": "datetime"
                },
                {
                  "readonly": true,
                  "operation": "Dust Weight (in gm) (A)",
                  "value__fieldType": "number"
                },
                {
                  "type": "header",
                  "label": "2nd Cut"
                },
                {
                  "readonly": true,
                  "operation": "Start Date & Time",
                  "value__fieldType": "datetime"
                },
                {
                  "readonly": true,
                  "operation": "End Date & Time",
                  "value__fieldType": "datetime"
                },
                {
                  "readonly": true,
                  "operation": "Dust Weight (in gm) (B)",
                  "value__fieldType": "number"
                },
                {
                  "readonly": true,
                  "operation": "Total Dust Weight (in gm) (A+B)",
                  "value__fieldType": "number"
                }
              ]
            },
            "columns": [
              {
                "type": "column",
                "id": "operation",
                "fieldType": "text",
                "label": "Operation",
                "readonly": true
              },
              {
                "type": "column",
                "id": "value",
                "fieldType": "dynamic",
                "label": "Value"
              },
              {
                "type": "column",
                "id": "remarksObservations",
                "fieldType": "textarea",
                "label": "Remarks / Observations"
              },
              {
                "type": "column",
                "id": "attachments",
                "fieldType": "image",
                "label": "Photos / Videos"
              }
            ]
          }
        ]
      },
      {
        "id": "bellowBonding",
        "title": "Bellow Bonding",
        "children": [
          {
            "type": "group",
            "id": "bellowBondingDetails",
            "ui": {
              "direction": "column",
              "wrap": false,
              "gap": "md"
            },
            "children": [
              {
                "type": "display",
                "id": "adhesiveDetailsHeading",
                "displayType": "heading",
                "label": "Adhesive Details",
                "value": ""
              },
              {
                "type": "field",
                "id": "adhesiveDetails",
                "fieldType": "text",
                "label": "Adhesive Details"
              },
              {
                "type": "field",
                "id": "heBellowDimension",
                "fieldType": "text",
                "label": "HE Bellow Dimension"
              },
              {
                "type": "field",
                "id": "heMotorPastingDateTime",
                "fieldType": "datetime",
                "label": "HE Pasting Date & Time",
                "ui": {
                  "maxWidth": "300px"
                }
              },
              {
                "type": "field",
                "id": "neBellowDimension",
                "fieldType": "text",
                "label": "NE Bellow Dimension"
              },
              {
                "type": "field",
                "id": "neMotorPastingDateTime",
                "fieldType": "datetime",
                "label": "NE Pasting Date & Time",
                "ui": {
                  "maxWidth": "300px"
                }
              },
              {
                "type": "field",
                "id": "numberOfSpacers",
                "fieldType": "number",
                "label": "No. of Spacers",
                "ui": {
                  "maxWidth": "200px"
                }
              },
              {
                "type": "field",
                "id": "pastingDetails",
                "fieldType": "text",
                "label": "Pasting Details"
              },
              {
                "type": "field",
                "id": "remarks",
                "fieldType": "textarea",
                "label": "Remarks",
                "ui": {
                  "colSpan": {
                    "xs": 12
                  },
                  "flex": "1 1 100%"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "tceCleaning",
        "title": "TCE Cleaning",
        "children": [
          {
            "type": "group",
            "id": "tceCleaningDetails",
            "ui": {
              "direction": "column",
              "wrap": false,
              "gap": "md"
            },
            "children": [
              {
                "type": "field",
                "id": "tceCleaningDateTime",
                "fieldType": "datetime",
                "label": "TCE Cleaning Date & Time",
                "ui": {
                  "maxWidth": "300px"
                }
              },
              {
                "type": "field",
                "id": "solventUsedQtyKg",
                "fieldType": "number",
                "label": "Solvent Used Qty (KG)",
                "ui": {
                  "maxWidth": "200px"
                }
              },
              {
                "type": "field",
                "id": "observation",
                "fieldType": "textarea",
                "label": "Observation",
                "ui": {
                  "colSpan": {
                    "xs": 12
                  },
                  "flex": "1 1 100%"
                }
              },
              {
                "type": "field",
                "id": "testReport",
                "fieldType": "file",
                "label": "Upload Test Report"
              }
            ]
          }
        ]
      },
      {
        "id": "preHeating",
        "title": "Pre-heating",
        "children": [
          {
            "type": "display",
            "id": "preHeatingConfigurationHeading",
            "displayType": "heading",
            "label": "Pre-heating Configuration",
            "value": ""
          },
          {
            "type": "group",
            "id": "vacuumBaggingGroup",
            "ui": {
              "direction": "column",
              "wrap": false,
              "gap": "sm"
            },
            "children": [
              {
                "type": "field",
                "id": "vacuumBaggingApplied",
                "fieldType": "dropdown",
                "label": "Vacuum Bagging Application",
                "dataSource": {
                  "type": "static",
                  "options": [
                    {
                      "label": "YES",
                      "value": "YES"
                    },
                    {
                      "label": "NO",
                      "value": "NO"
                    }
                  ]
                },
                "ui": {
                  "maxWidth": "240px"
                }
              },
              {
                "type": "display",
                "id": "vacuumAppliedHint",
                "displayType": "description",
                "label": "If YES, then vacuum applied",
                "value": "",
                "visibleWhen": {
                  "when": [
                    {
                      "field": "vacuumBaggingApplied",
                      "op": "EQUAL",
                      "value": "YES"
                    }
                  ],
                  "logic": "AND"
                }
              },
              {
                "type": "field",
                "id": "vacuumApplied",
                "fieldType": "number",
                "label": "Enter vacuum value",
                "visibleWhen": {
                  "when": [
                    {
                      "field": "vacuumBaggingApplied",
                      "op": "EQUAL",
                      "value": "YES"
                    }
                  ],
                  "logic": "AND"
                },
                "ui": {
                  "maxWidth": "240px"
                }
              }
            ]
          },
          {
            "type": "field",
            "id": "preHeatingRecipe",
            "fieldType": "dropdown",
            "label": "Pre-heating Recipe",
            "dataSource": {
              "type": "static",
              "options": [
                {
                  "label": "85-90°C for 6 hrs with 10 hrs vacuum",
                  "value": "85_90C_6HR_10HR_VACUUM"
                },
                {
                  "label": "105°C for 8 hrs",
                  "value": "105C_8HR"
                },
                {
                  "label": "Others",
                  "value": "OTHERS"
                }
              ]
            }
          },
          {
            "type": "field",
            "id": "otherTemperature",
            "fieldType": "number",
            "label": "Other Temperature",
            "unit": "°C",
            "visibleWhen": {
              "when": [
                {
                  "field": "preHeatingRecipe",
                  "op": "EQUAL",
                  "value": "OTHERS"
                }
              ],
              "logic": "AND"
            }
          },
          {
            "type": "field",
            "id": "otherDuration",
            "fieldType": "number",
            "label": "Other Duration",
            "unit": "Hours",
            "visibleWhen": {
              "when": [
                {
                  "field": "preHeatingRecipe",
                  "op": "EQUAL",
                  "value": "OTHERS"
                }
              ],
              "logic": "AND"
            }
          },
          {
            "type": "display",
            "id": "temperatureDurationHeading",
            "displayType": "heading",
            "label": "Temperature Duration",
            "value": "",
            "visibleWhen": {
              "when": [
                {
                  "field": "preHeatingRecipe",
                  "op": "NOT_EMPTY"
                }
              ],
              "logic": "AND"
            }
          },
          {
            "type": "table",
            "id": "temperatureDuration",
            "title": "Temperature Duration",
            "visibleWhen": {
              "logic": "OR",
              "when": [
                {
                  "field": "preHeatingRecipe",
                  "op": "IN",
                  "value": [
                    "85_90C_6HR_10HR_VACUUM",
                    "105C_8HR"
                  ]
                },
                {
                  "logic": "AND",
                  "when": [
                    {
                      "field": "preHeatingRecipe",
                      "op": "EQUAL",
                      "value": "OTHERS"
                    },
                    {
                      "field": "otherDuration",
                      "op": "NOT_EMPTY"
                    }
                  ]
                }
              ]
            },
            "rows": {
              "allowAdd": false,
              "allowDelete": false,
              "autoIncrementKey": "SR_NO",
              "defaultCount": 0,
              "max": 12,
              "rowGenerationCount": {
                "countField": "otherDuration",
                "countByFieldValue": {
                  "field": "preHeatingRecipe",
                  "values": {
                    "85_90C_6HR_10HR_VACUUM": 6,
                    "105C_8HR": 8
                  }
                },
                "labelTemplate": "Temperature @ {n} Hour",
                "labelColumn": "parameter",
                "rowDefaults": {
                  "value__fieldType": "number"
                },
                "min": 0,
                "max": 12
              }
            },
            "columns": [
              {
                "type": "column",
                "id": "parameter",
                "fieldType": "text",
                "label": "Parameter",
                "readonly": true
              },
              {
                "type": "column",
                "id": "value",
                "fieldType": "dynamic",
                "label": "Value"
              },
              {
                "type": "column",
                "id": "remarks",
                "fieldType": "textarea",
                "label": "Remarks"
              }
            ]
          },
          {
            "type": "table",
            "id": "preHeatingMonitoring",
            "title": "Pre-heating Monitoring",
            "rows": {
              "allowAdd": false,
              "allowDelete": false,
              "autoIncrementKey": "SR_NO",
              "defaultCount": 5,
              "presetRows": [
                {
                  "readonly": true,
                  "parameter": "Date",
                  "value__fieldType": "date"
                },
                {
                  "readonly": true,
                  "parameter": "Oven Start Time",
                  "value__fieldType": "time"
                },
                {
                  "readonly": true,
                  "parameter": "Cycle Start Time",
                  "value__fieldType": "time"
                },
                {
                  "readonly": true,
                  "parameter": "Cycle End Time",
                  "value__fieldType": "time"
                },
                {
                  "readonly": true,
                  "parameter": "Visual Observation After Pre-heating",
                  "value__fieldType": "textarea"
                }
              ]
            },
            "columns": [
              {
                "type": "column",
                "id": "parameter",
                "fieldType": "text",
                "label": "Parameter",
                "readonly": true
              },
              {
                "type": "column",
                "id": "value",
                "fieldType": "dynamic",
                "label": "Value"
              },
              {
                "type": "column",
                "id": "remarks",
                "fieldType": "textarea",
                "label": "Remarks"
              }
            ]
          }
        ]
      },
      {
        "id": "linerCoatingOperation",
        "title": "Liner Coating Operation",
        "children": [
          {
            "type": "group",
            "id": "linerCoatingOperation",
            "label": "Liner Coating Operation",
            "children": [
              {
                "type": "field",
                "id": "linerType",
                "fieldType": "dropdown",
                "label": "Select Liner Type",
                "validation": {
                  "required": true
                },
                "dataSource": {
                  "type": "static",
                  "options": [
                    {
                      "label": "PEDCOAT",
                      "value": "PEDCOAT"
                    },
                    {
                      "label": "HEMCOAT-3L",
                      "value": "HEMCOAT_3L"
                    },
                    {
                      "label": "HEMCOAT-3L-M",
                      "value": "HEMCOAT_3L_M"
                    },
                    {
                      "label": "Others",
                      "value": "OTHERS"
                    }
                  ]
                }
              },
              {
                "type": "field",
                "id": "otherLinerType",
                "fieldType": "text",
                "label": "Other Liner Type",
                "visibleWhen": {
                  "when": [
                    {
                      "field": "linerType",
                      "op": "EQUAL",
                      "value": "OTHERS"
                    }
                  ],
                  "logic": "AND"
                }
              },
              {
                "type": "group",
                "id": "linerPreparationDetails",
                "label": "Liner Preparation Details",
                "children": [
                  {
                    "type": "field",
                    "id": "batchNo",
                    "fieldType": "text",
                    "label": "Batch No."
                  },
                  {
                    "type": "field",
                    "id": "batchSize",
                    "fieldType": "number",
                    "label": "Batch Size",
                    "readonly": true,
                    "populateFromApi": {
                      "dataSource": {
                        "type": "api",
                        "api": {
                          "endpoint": "/api/v1/admin/batch/details",
                          "method": "POST",
                          "requestBody": {
                            "batchId": "{{batchId}}"
                          },
                          "responsePath": "data.batch.identificationSheet.batchSize"
                        }
                      }
                    }
                  }
                ]
              },
              {
                "type": "table",
                "id": "premixIngredients",
                "title": "Premix",
                "rows": {
                  "allowAdd": false,
                  "allowDelete": false,
                  "autoIncrementKey": "srNo",
                  "populateFromApi": {
                    "dataSource": {
                      "type": "api",
                      "api": {
                        "endpoint": "/api/v1/admin/batch/details",
                        "method": "POST",
                        "requestBody": {
                          "batchId": "{{batchId}}"
                        },
                        "responsePath": "data.batch.identificationSheet.materials"
                      }
                    },
                    "fieldMappings": [
                      {
                        "sourceField": "materialCode",
                        "targetColumn": "ingredient"
                      },
                      {
                        "sourceField": "materialName",
                        "targetColumn": "materialName"
                      },
                      {
                        "sourceField": "requiredComposition",
                        "targetColumn": "partsByWeight"
                      },
                      {
                        "sourceField": "lotId",
                        "targetColumn": "mfgLot"
                      },
                      {
                        "sourceField": "quantityPerPremix",
                        "targetColumn": "quantityTaken"
                      }
                    ],
                    "readonlyColumns": [
                      "ingredient",
                      "materialName",
                      "mfgLot"
                    ]
                  }
                },
                "columns": [
                  {
                    "type": "column",
                    "id": "srNo",
                    "fieldType": "serial",
                    "label": "Sr. No.",
                    "readonly": true
                  },
                  {
                    "type": "column",
                    "id": "materialName",
                    "fieldType": "text",
                    "label": "Material Name",
                    "readonly": true
                  },
                  {
                    "type": "column",
                    "id": "ingredient",
                    "fieldType": "text",
                    "label": "Material Code",
                    "readonly": true
                  },
                  {
                    "type": "column",
                    "id": "mfgLot",
                    "fieldType": "text",
                    "label": "Mfg. Lot",
                    "readonly": true
                  },
                  {
                    "type": "column",
                    "id": "partsByWeight",
                    "fieldType": "decimal",
                    "label": "Parts by Wt."
                  },
                  {
                    "type": "column",
                    "id": "quantityTaken",
                    "fieldType": "decimal",
                    "label": "Quantity Taken (g)"
                  },
                  {
                    "type": "column",
                    "id": "totalQuantity",
                    "fieldType": "decimal",
                    "label": "Total Quantity (g)"
                  }
                ]
              },
              {
                "type": "table",
                "id": "finalMixIngredients",
                "title": "Final Mix",
                "rows": {
                  "allowAdd": false,
                  "allowDelete": false,
                  "autoIncrementKey": "srNo",
                  "populateFromApi": {
                    "dataSource": {
                      "type": "api",
                      "api": {
                        "endpoint": "/api/v1/admin/batch/details",
                        "method": "POST",
                        "requestBody": {
                          "batchId": "{{batchId}}"
                        },
                        "responsePath": "data.batch.identificationSheet.materials"
                      }
                    },
                    "fieldMappings": [
                      {
                        "sourceField": "materialCode",
                        "targetColumn": "ingredient"
                      },
                      {
                        "sourceField": "materialName",
                        "targetColumn": "materialName"
                      },
                      {
                        "sourceField": "requiredComposition",
                        "targetColumn": "partsByWeight"
                      },
                      {
                        "sourceField": "lotId",
                        "targetColumn": "mfgLot"
                      },
                      {
                        "sourceField": "quantityPerPremix",
                        "targetColumn": "quantityTaken"
                      }
                    ],
                    "readonlyColumns": [
                      "ingredient",
                      "materialName",
                      "mfgLot"
                    ]
                  }
                },
                "columns": [
                  {
                    "type": "column",
                    "id": "srNo",
                    "fieldType": "serial",
                    "label": "Sr. No.",
                    "readonly": true
                  },
                  {
                    "type": "column",
                    "id": "materialName",
                    "fieldType": "text",
                    "label": "Material Name",
                    "readonly": true
                  },
                  {
                    "type": "column",
                    "id": "ingredient",
                    "fieldType": "text",
                    "label": "Material Code",
                    "readonly": true
                  },
                  {
                    "type": "column",
                    "id": "mfgLot",
                    "fieldType": "text",
                    "label": "Mfg. Lot",
                    "readonly": true
                  },
                  {
                    "type": "column",
                    "id": "partsByWeight",
                    "fieldType": "decimal",
                    "label": "Parts by Wt."
                  },
                  {
                    "type": "column",
                    "id": "quantityTaken",
                    "fieldType": "decimal",
                    "label": "Quantity Taken (g)"
                  },
                  {
                    "type": "column",
                    "id": "totalQuantity",
                    "fieldType": "decimal",
                    "label": "Total Quantity (g)"
                  }
                ]
              },
              {
                "type": "group",
                "id": "qualificationDetails",
                "label": "Qualification Details",
                "children": [
                  {
                    "type": "field",
                    "id": "qualifyingSubscaleBatchNo",
                    "fieldType": "text",
                    "label": "Qualifying Subscale Batch No."
                  },
                  {
                    "type": "table",
                    "id": "qualificationParameters",
                    "title": "Qualification Parameters",
                    "rows": {
                      "allowAdd": true,
                      "allowDelete": true,
                      "autoIncrementKey": "srNo",
                      "defaultCount": 4,
                      "presetRows": [
                        {
                          "readonly": true,
                          "srNo": 1,
                          "parameter": "SBS",
                          "specification": ">=5"
                        },
                        {
                          "readonly": true,
                          "srNo": 2,
                          "parameter": "TBS",
                          "specification": ">=5"
                        },
                        {
                          "readonly": true,
                          "srNo": 3,
                          "parameter": "Peel Strength",
                          "specification": ">=0.6"
                        },
                        {
                          "readonly": true,
                          "srNo": 4,
                          "parameter": "Moisture",
                          "specification": "<=0.25"
                        }
                      ]
                    },
                    "columns": [
                      {
                        "type": "column",
                        "id": "srNo",
                        "fieldType": "serial",
                        "label": "Sr. No.",
                        "readonly": true
                      },
                      {
                        "type": "column",
                        "id": "parameter",
                        "fieldType": "text",
                        "label": "Parameter",
                        "readonly": true
                      },
                      {
                        "type": "column",
                        "id": "specification",
                        "fieldType": "text",
                        "label": "Specification",
                        "readonly": true
                      },
                      {
                        "type": "column",
                        "id": "result",
                        "fieldType": "text",
                        "label": "Result"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "table",
                "id": "linerApplicationLog",
                "title": "Liner Application Process Log",
                "rows": {
                  "allowAdd": false,
                  "allowDelete": false,
                  "autoIncrementKey": "SR_NO",
                  "defaultCount": 13,
                  "presetRows": [
                    {
                      "readonly": true,
                      "parameter": "Date",
                      "value__fieldType": "date"
                    },
                    {
                      "readonly": true,
                      "parameter": "Oven Out Time",
                      "value__fieldType": "time"
                    },
                    {
                      "readonly": true,
                      "parameter": "Rocket Motor Insulation Temp",
                      "value__fieldType": "number"
                    },
                    {
                      "readonly": true,
                      "parameter": "Rocket Motor RPM",
                      "value__fieldType": "number"
                    },
                    {
                      "readonly": true,
                      "parameter": "Boom Speed",
                      "value__fieldType": "number"
                    },
                    {
                      "readonly": true,
                      "parameter": "Start Temperature",
                      "value__fieldType": "number"
