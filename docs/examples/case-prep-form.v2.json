          {
            "type": "group",
            "id": "vacuumBaggingGroup",
            "ui": {
              "direction": "column",
              "wrap": false,
              "gap": "sm"
            },
            "children": [
              {
                "type": "field",
                "id": "vacuumBaggingApplied",
                "fieldType": "dropdown",
                "label": "Vacuum Bagging Application",
                "dataSource": {
                  "type": "static",
                  "options": [
                    {
                      "label": "YES",
                      "value": "YES"
                    },
                    {
                      "label": "NO",
                      "value": "NO"
                    }
                  ]
                },
                "ui": {
                  "maxWidth": "240px"
                }
              },
              {
                "type": "display",
                "id": "vacuumAppliedHint",
                "displayType": "description",
                "label": "If YES, then vacuum applied",
                "value": "",
                "visibleWhen": {
                  "when": [
                    {
                      "field": "vacuumBaggingApplied",
                      "op": "EQUAL",
                      "value": "YES"
                    }
                  ],
                  "logic": "AND"
                }
              },
              {
                "type": "field",
                "id": "vacuumApplied",
                "fieldType": "number",
                "label": "Enter vacuum value",
                "visibleWhen": {
                  "when": [
                    {
                      "field": "vacuumBaggingApplied",
                      "op": "EQUAL",
                      "value": "YES"
                    }
                  ],
                  "logic": "AND"
                },
                "ui": {
                  "maxWidth": "240px"
                }
              }
            ]
          },
          {
            "type": "field",
            "id": "preHeatingRecipe",
            "fieldType": "dropdown",
            "label": "Pre-heating Recipe",
            "dataSource": {
              "type": "static",
              "options": [
                {
                  "label": "85-90°C for 6 hrs with 10 hrs vacuum",
                  "value": "85_90C_6HR_10HR_VACUUM"
                },
                {
                  "label": "105°C for 8 hrs",
                  "value": "105C_8HR"
                },
                {
                  "label": "Others",
                  "value": "OTHERS"
                }
              ]
            }
          },
          {
            "type": "field",
            "id": "otherTemperature",
            "fieldType": "number",
            "label": "Other Temperature",
            "unit": "°C",
            "visibleWhen": {
              "when": [
                {
                  "field": "preHeatingRecipe",
                  "op": "EQUAL",
                  "value": "OTHERS"
                }
              ],
              "logic": "AND"
            }
          },
          {
            "type": "field",
            "id": "otherDuration",
            "fieldType": "number",
            "label": "Other Duration",
            "unit": "Hours",
            "visibleWhen": {
              "when": [
                {
                  "field": "preHeatingRecipe",
                  "op": "EQUAL",
                  "value": "OTHERS"
                }
              ],
              "logic": "AND"
            }
          },
